# Copie en .env, puis : set -a; source .env; set +a; make run
LISTEN_ADDR=:8080
API_TOKEN=change-me

# Identifiants Keystone (équivalent de "source openrc admin admin")
OS_AUTH_URL=http://192.168.1.50/identity
OS_USERNAME=admin
OS_PASSWORD=secret
OS_PROJECT_NAME=admin
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=RegionOne
